# Private, machine-specific settings for the host-side scripts
# (push_to_pi.sh, connect_to_pi.sh).
#
# Copy this file to .env and fill it in. .env is git-ignored, so your Pi's
# address and username never end up in the public repository.
#
#   cp .env.example .env

# Pi address: a LAN IP, a hostname, or a Tailscale MagicDNS name
# (for example the Pi's tailnet hostname) so pushes work from anywhere.
DEATHSTAR_PI_HOST=

# Username on the Pi
DEATHSTAR_PI_USER=
